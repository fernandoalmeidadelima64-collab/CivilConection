# ==============================================================================
# CIVIL CONNECTION - EXEMPLO DE VARIÁVEIS DE AMBIENTE
# Copie este arquivo para .env e preencha com suas credenciais do Supabase
# ==============================================================================

# Conexão com o banco de dados Supabase PostgreSQL (usado pelo Spring Boot Backend)
# Host e porta do pooler do Supabase (ex: aws-0-sa-east-1.pooler.supabase.com)
SPRING_DATASOURCE_URL=jdbc:postgresql://db.<SUA-REFERENCIA-SUPABASE>.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.<SUA-REFERENCIA-SUPABASE>
SPRING_DATASOURCE_PASSWORD=sua-senha-do-banco-aqui

# Configurações do Supabase API (se integrado diretamente no Frontend via JS)
SUPABASE_URL=https://<SUA-REFERENCIA-SUPABASE>.supabase.co
SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui

# Porta do servidor Spring Boot (padrão: 8080)
SERVER_PORT=8080
