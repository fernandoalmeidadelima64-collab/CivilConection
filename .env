# ==============================================================================
# CIVIL CONNECTION - CONFIGURAÇÕES DO AMBIENTE (SUPABASE & SPRING BOOT)
# Projeto Teste / Acadêmico Etec
# ==============================================================================

# Conexão com o banco de dados Supabase PostgreSQL:
# Exemplo de URL direta: jdbc:postgresql://db.exemplo123.supabase.co:5432/postgres?sslmode=require
# Exemplo de URL pooler: jdbc:postgresql://aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://db.SEU_PROJETO_AQUI.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.SEU_PROJETO_AQUI
SPRING_DATASOURCE_PASSWORD=SUA_SENHA_AQUI

# Credenciais de API pública do Supabase (para uso no Frontend / Auth se desejar):
SUPABASE_URL=https://SEU_PROJETO_AQUI.supabase.co
SUPABASE_ANON_KEY=SUA_ANON_KEY_AQUI

# Porta padrão do servidor web Spring Boot
SERVER_PORT=8080
